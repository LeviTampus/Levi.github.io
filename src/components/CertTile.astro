---
import type { CollectionEntry } from 'astro:content';

interface Props {
  cert: CollectionEntry<'certs'>;
  priority?: boolean;
}

const { cert, priority = false } = Astro.props;
const { title, issuer, verifyUrl, verifyLabel, asset, width, height } = cert.data;
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
---
<article class="cert">
  <a class="cert-link" href={verifyUrl} target="_blank" rel="noopener noreferrer">
    <img
      src={`${base}/certs/${asset}`}
      alt={`Certificate: ${title} (${issuer})`}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
      width={width}
      height={height}
    />
    <h2>{title}</h2>
    <p class="issuer">{verifyLabel ?? `Verify at ${issuer}`}</p>
  </a>
</article>

<style>
  /* Fill the grid cell so tiles are uniform; issuer sits on a common baseline. */
  .cert {
    display: flex;
  }

  .cert a {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    color: var(--ink);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    transition: border-color 120ms ease;
  }

  .cert img {
    display: block;
    flex: 0 0 auto;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-bottom: 1px solid var(--border);
  }

  .cert h2 {
    font-size: 0.95rem;
    margin: 0.75rem 0.9rem 0.15rem;
    transition: color 120ms ease;
  }

  .issuer {
    margin: auto 0.9rem 0.8rem;
    color: var(--muted);
  }

  @media (hover: hover) and (pointer: fine) {
    .cert a:hover {
      border-color: var(--accent);
    }

    .cert a:hover h2 {
      color: var(--accent-strong);
    }
  }
</style>
