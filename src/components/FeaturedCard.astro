---
import type { CollectionEntry } from 'astro:content';
import Button from './Button.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, type, tagline, links, featured, trace, assets } = project.data;
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const caseHref = `${base}/projects/${project.slug}`;
const hasPanel = Boolean(trace) || Boolean(assets.image);

const badge: Record<string, string> = {
  professional: 'Professional',
  personal: 'Personal',
  learning: 'Learning',
};
---
<article class={`featured-card${hasPanel ? '' : ' no-trace'}`}>
  <div class="copy">
    <p class="tags">
      <span class="tag badge">{badge[type]}</span>
      {featured && <span class="tag featured-tag">Featured</span>}
    </p>
    <h3><a class="title-link" href={caseHref}>{title}</a></h3>
    <p class="tagline">{tagline}</p>
    <p class="links">
      {links.demo ? (
        <Button href={links.demo} external>{links.demoLabel ?? 'Live demo'}</Button>
      ) : links.repo ? (
        <Button href={links.repo} external>View on GitHub</Button>
      ) : null}
      <a class="case-link" href={caseHref}>
        Read the full case study <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>

  {trace && (
    <div class="trace" aria-hidden="true">
      <div class="trace-head">
        <span class="trace-dot"></span>
        <span class="trace-title">{trace.title}</span>
        <span class="trace-status">{trace.status}</span>
      </div>
      <ol class="trace-steps">
        {trace.steps.map((step, i) => (
          <li>
            <span class="trace-index">{String(i + 1).padStart(2, '0')}</span>
            <span class="trace-label">{step}</span>
          </li>
        ))}
      </ol>
    </div>
  )}

  {!trace && assets.image && (
    <figure class="shot">
      <img
        src={`${base}/${assets.image}`}
        alt={assets.imageAlt ?? `${title} snapshot`}
        width={assets.imageWidth}
        height={assets.imageHeight}
        loading="lazy"
        decoding="async"
      />
    </figure>
  )}
</article>

<style>
  .featured-card {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 1.75rem;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1.5rem;
  }

  .featured-card.no-trace {
    grid-template-columns: minmax(0, 1fr);
  }

  .copy {
    min-width: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 0.6rem;
  }

  .badge,
  .featured-tag {
    display: inline-block;
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
    margin: 0;
  }

  .badge {
    color: var(--muted);
    background: var(--surface-tint);
    border: 1px solid var(--border);
  }

  .featured-tag {
    color: var(--accent-strong);
    background: var(--accent-soft);
  }

  .featured-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.35rem;
  }

  .title-link {
    color: inherit;
    text-decoration: none;
  }

  .tagline {
    margin: 0 0 1rem;
    color: var(--muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin: 0;
  }

  .case-link {
    font-weight: 600;
  }

  @media (hover: hover) and (pointer: fine) {
    .title-link:hover,
    .case-link:hover {
      color: var(--accent-strong);
    }
  }

  /* Optional visual panel: a trace (e.g. an agent loop) or a screenshot. */
  .trace {
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    background: var(--bg);
    padding: 1rem 1.1rem;
  }

  .shot {
    margin: 0;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    background: var(--surface-tint);
  }

  .trace-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .trace-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .trace-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .trace-status {
    margin-left: auto;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--accent-strong);
    background: var(--accent-soft);
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
  }

  .trace-steps {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0.35rem 0 0;
  }

  .trace-steps::before {
    content: '';
    position: absolute;
    left: 0.25rem;
    top: 1rem;
    bottom: 1rem;
    width: 1px;
    background: var(--rule);
  }

  .trace-steps li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.35rem 0;
  }

  .trace-steps li::before {
    content: '';
    flex: 0 0 auto;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--rule);
    z-index: 1;
  }

  .trace-steps li:last-child::before {
    background: var(--accent);
    border-color: var(--accent);
  }

  .trace-index {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }

  .trace-label {
    font-size: 0.82rem;
    color: var(--ink);
  }

  @media (max-width: 760px) {
    .featured-card {
      grid-template-columns: 1fr;
    }

    .trace {
      max-width: 24rem;
    }
  }
</style>
