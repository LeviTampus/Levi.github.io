---
import Button from './Button.astro';

const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const heroSrc = `${base}/hero-illustration.webp`;
---
<section id="hero" aria-label="Introduction" class="hero">
  <div class="hero-copy">
    <p class="eyebrow">Hey, I'm</p>
    <h1>
      <span class="name-line">
        Levi
        <svg class="swoosh" aria-hidden="true" viewBox="0 0 420 24" preserveAspectRatio="none">
          <path
            d="M4 18 C 80 6, 160 22, 240 14 S 380 8, 416 16"
            stroke="currentColor"
            stroke-width="7"
            fill="none"
            stroke-linecap="round"
          />
        </svg>
      </span>
    </h1>
    <p class="lede">
      Senior Product Support and Integrations Specialist with 11 years of
      professional support experience, including 4 years specializing in
      enterprise integrations.
    </p>
    <p class="cta">
      <Button href={`${base}/projects`}>View projects</Button>
      <Button href={`mailto:${import.meta.env.SITE_EMAIL ?? 'levijoantampus@gmail.com'}`} variant="secondary">Get in touch</Button>
    </p>
  </div>

  <div class="hero-stage">
    <span class="wash" aria-hidden="true"></span>
    <figure class="hero-art">
      <img
        src={heroSrc}
        alt="Illustration of Levi smiling and holding a mug that reads “Good Systems Better Coffee”, with a sleeping cat beside her"
        width="1536"
        height="1024"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption class="sr-only">Build, learn, break, repeat.</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 2rem 2.5rem;
    align-items: center;
    padding-top: 1.5rem;
  }

  .eyebrow {
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: 1.6rem;
    color: var(--accent-strong);
    margin: 0 0 0.1rem;
  }

  h1 {
    font-size: clamp(3.25rem, 9vw, 6rem);
    line-height: 1;
    margin: 0 0 1.1rem;
    letter-spacing: -0.02em;
  }

  .name-line {
    position: relative;
    display: inline-block;
    color: var(--ink);
  }

  .swoosh {
    position: absolute;
    left: -0.08em;
    right: -0.08em;
    bottom: -0.02em;
    width: calc(100% + 0.16em);
    height: 0.32em;
    color: var(--accent);
    pointer-events: none;
  }

  .lede {
    font-size: 1.25rem;
    max-width: 40rem;
    margin: 0 0 1.5rem;
    color: var(--ink);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin: 0;
  }

  .hero-stage {
    position: relative;
    width: 100%;
    justify-self: center;
    isolation: isolate;
  }

  .wash {
    position: absolute;
    z-index: 0;
    inset: 4% -4% -2% -4%;
    border-radius: 58% 42% 52% 48% / 52% 56% 44% 48%;
    background: radial-gradient(closest-side, var(--accent-soft) 58%, rgba(253, 238, 229, 0) 82%);
  }

  .hero-art {
    position: relative;
    z-index: 1;
    margin: 0;
    width: 100%;
  }

  .hero-art img {
    display: block;
    width: min(100%, 40rem);
    height: auto;
    margin: 0 auto;
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      text-align: center;
    }

    .lede {
      margin-left: auto;
      margin-right: auto;
    }

    .cta {
      justify-content: center;
    }

    .hero-art img {
      width: min(100%, 28rem);
    }
  }
</style>
