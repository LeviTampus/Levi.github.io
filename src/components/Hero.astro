---
import Button from './Button.astro';

const heroSrc = `${import.meta.env.BASE_URL}/hero-illustration.webp`;
---
<section id="hero" aria-label="Introduction" class="hero">
  <div class="hero-copy">
    <p class="hey"><span aria-hidden="true">👋</span> Hey, I'm</p>
    <h1><span class="name">Levi Joan Tampus</span></h1>
    <p class="lede">
      Technical support and integrations specialist with 11 years of
      experience — currently at Workato, where I troubleshoot integrations and
      APIs, automate workflows, and build with AI agents.
    </p>
    <p class="lede personal">
      I like figuring out why things break, how systems connect, and what
      happens when you give those systems a little intelligence.
    </p>
    <p class="cta">
      <Button href="#projects">View projects →</Button>
      <Button href="#contact" variant="secondary">Get in touch</Button>
    </p>
    <p class="progression handnote">
      Support → Integrations → APIs → Automation → Troubleshooting → AI
    </p>
  </div>

  <div class="hero-stage">
    <span class="blob blob-a" aria-hidden="true"></span>
    <span class="blob blob-b" aria-hidden="true"></span>

    <figure class="hero-art">
      <img
        src={heroSrc}
        alt="Illustration of Levi smiling and holding a mug that reads “Good Systems Better Coffee”, with a sleeping cat beside her"
        width="360"
        height="380"
      />
      <figcaption class="sr-only">Build, learn, break, repeat.</figcaption>
    </figure>

    <span class="deco note-build handnote" aria-hidden="true">Build · Learn<br />Break · Repeat ♡</span>
    <span class="deco note-curiosity handnote" aria-hidden="true">Same curiosity,<br />higher altitude ♡</span>
    <svg class="deco spark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 2l1.8 6.2L20 10l-6.2 1.8L12 18l-1.8-6.2L4 10l6.2-1.8z" fill="currentColor" />
    </svg>
    <svg class="deco heart" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 20s-7-4.6-7-9.5A4 4 0 0 1 12 7a4 4 0 0 1 7 3.5C19 15.4 12 20 12 20z" fill="currentColor" />
    </svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 1.5rem 2rem;
    align-items: center;
  }

  .hey {
    font-weight: 800;
    font-size: 1.1rem;
    margin: 0;
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    line-height: 1.1;
    margin: 0.25rem 0 1rem;
    letter-spacing: -0.02em;
  }

  .name {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.15em;
  }

  .lede {
    font-size: 1.15rem;
    max-width: 44rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0 0 0.5rem;
  }

  .progression {
    display: block;
    margin: 0;
    font-size: 1.15rem;
    color: var(--accent-strong);
  }

  .hero-stage {
    position: relative;
    width: 100%;
    justify-self: center;
    padding: 0.5rem 0;
    isolation: isolate;
  }

  /* Painted washes behind the illustration so it sits inside the page's warm
     palette instead of floating on a flat background. */
  .blob {
    position: absolute;
    z-index: 0;
    border-radius: 52% 48% 55% 45% / 48% 54% 46% 52%;
  }

  .blob-a {
    inset: 6% 6% 4% 4%;
    background: radial-gradient(closest-side, #f6e2d1 56%, rgba(246, 226, 209, 0) 100%);
  }

  .blob-b {
    inset: 20% -4% 0 22%;
    transform: rotate(-7deg);
    background: radial-gradient(closest-side, rgba(236, 233, 251, 0.9) 50%, rgba(236, 233, 251, 0) 100%);
  }

  .hero-art {
    position: relative;
    z-index: 1;
    margin: 0;
    width: 100%;
  }

  .hero-art img {
    display: block;
    width: min(100%, 27rem);
    height: auto;
    margin: 0 auto;
  }

  .deco {
    position: absolute;
    pointer-events: none;
  }

  .note-build {
    z-index: 2;
    top: 0;
    right: 0;
    text-align: right;
    font-size: 1.5rem;
    transform: rotate(5deg);
  }

  .note-curiosity {
    z-index: 2;
    bottom: 0;
    left: 0;
    transform: rotate(-5deg);
  }

  .spark {
    z-index: 2;
    top: 36%;
    right: 4%;
    width: 1.6rem;
    height: 1.6rem;
    color: var(--accent);
  }

  .heart {
    z-index: 2;
    bottom: 18%;
    left: 2%;
    width: 1.2rem;
    height: 1.2rem;
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-art img {
      width: min(100%, 22rem);
    }

    .note-build,
    .note-curiosity {
      display: none;
    }

    .progression {
      font-size: 1.05rem;
    }
  }
</style>
