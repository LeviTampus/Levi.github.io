---
import type { CollectionEntry } from 'astro:content';
import FeaturedCard from './FeaturedCard.astro';
import Role from './Role.astro';
import { skillIcons } from '../data/skillIcons';
import { site } from '../data/site';

interface Props {
  projects: CollectionEntry<'projects'>[];
  experience: CollectionEntry<'experience'>[];
}

const { projects, experience } = Astro.props;
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
---
<section id="featured" aria-label="Featured projects and recent experience">
  <div class="featured">
    <div class="col-header">
      <h2>
        <span class="icon" aria-hidden="true" set:html={skillIcons.Folder} />
        Featured projects
      </h2>
      <a href={`${base}/projects`} class="view-all">View all projects</a>
    </div>
    <div class="featured-cards">
      {projects.map((project) => (
        <FeaturedCard project={project} />
      ))}
    </div>
  </div>

  <aside class="recent" aria-label="Recent experience">
    <div class="col-header">
      <h2>
        <span class="icon" aria-hidden="true" set:html={skillIcons.Briefcase} />
        Recent experience
      </h2>
      <a
        href={site.linkedin}
        class="view-all"
        target="_blank"
        rel="noopener noreferrer"
      >View all</a>
    </div>
    <div class="roles">
      {experience.map((entry) => (
        <Role
          company={entry.data.company}
          title={entry.data.title}
          dates={entry.data.dates}
          bullets={entry.data.bullets}
          variant={entry.data.tier}
        />
      ))}
    </div>
  </aside>
</section>

<style>
  .featured-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    align-items: stretch;
  }

  .recent {
    margin-top: 2.5rem;
  }

  .col-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 0.85rem;
  }

  .col-header h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: 1.15rem;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--accent);
  }

  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .col-header .icon {
    width: 1rem;
    height: 1rem;
  }

  .view-all {
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .view-all:hover {
    text-decoration: underline;
  }

  .roles {
    display: grid;
    gap: 0.55rem;
  }

  @media (max-width: 760px) {
    .featured-cards {
      grid-template-columns: 1fr;
    }
  }

  @media (pointer: coarse) {
    .view-all {
      padding-block: 0.65rem;
      margin-block: -0.65rem;
    }
  }
</style>
