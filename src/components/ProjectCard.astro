---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, type, tagline, technologies, links, tbd } = project.data;

const badge: Record<string, string> = {
  professional: 'Professional',
  personal: 'Personal',
  learning: 'Learning',
};
---
<article class="card">
  <header>
    <p class="tag badge">{badge[type]}</p>
    <h3>{title}</h3>
    <p>{tagline}</p>
  </header>
  <div class="prose">
    <slot />
  </div>
  {technologies.length > 0 && (
    <ul class="tech" aria-label="Technologies">
      {technologies.map((t) => (
        <li class="tag">{t}</li>
      ))}
    </ul>
  )}
  {tbd.length > 0 && (
    <p class="tag tbd-note">Details coming soon: {tbd.join(', ')}.</p>
  )}
  {(links.demo || links.repo || links.video) && (
    <p class="links">
      {links.demo && (
        <a class="button small" href={links.demo} target="_blank" rel="noopener noreferrer">Live demo</a>
      )}
      {links.repo && (
        <a href={links.repo} target="_blank" rel="noopener noreferrer">Repository</a>
      )}
      {links.video && (
        <a href={links.video} target="_blank" rel="noopener noreferrer">Video</a>
      )}
    </p>
  )}
</article>

<style>
  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .card h3 {
    margin: 0.25rem 0 0.5rem;
  }

  .badge {
    display: inline-block;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    padding: 0.1rem 0.5rem;
    margin: 0;
  }

  .prose :global(h2) {
    font-size: 1rem;
    margin: 1.25rem 0 0.5rem;
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .tech li {
    background: var(--surface-raised);
    border-radius: var(--radius);
    padding: 0.2rem 0.55rem;
  }

  .tbd-note {
    color: var(--muted);
  }

  .links {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-bottom: 0;
  }

  .button.small {
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
    text-decoration: none;
    border-radius: var(--radius);
    padding: 0.4rem 0.9rem;
  }
</style>
