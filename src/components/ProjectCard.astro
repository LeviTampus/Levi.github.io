---
import type { CollectionEntry } from 'astro:content';
import Button from './Button.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, type, tagline, technologies, links, featured } = project.data;

const badge: Record<string, string> = {
  professional: 'Professional',
  personal: 'Personal',
  learning: 'Learning',
};
---
<article class={`card${featured ? ' featured' : ''}`}>
  <header>
    <p class="tags">
      <span class="tag badge">{badge[type]}</span>
      {featured && <span class="tag featured-tag">Featured</span>}
    </p>
    <h3>{title}</h3>
    <p class="tagline">{tagline}</p>
  </header>
  <div class="prose">
    <slot />
  </div>
  {technologies.length > 0 && (
    <ul class="tech" aria-label="Technologies">
      {technologies.map((t) => (
        <li class="tag">{t}</li>
      ))}
    </ul>
  )}
  {(links.demo || links.repo || links.video) && (
    <p class="links">
      {links.demo && <Button href={links.demo} external>Live demo →</Button>}
      {links.repo && (
        <a href={links.repo} target="_blank" rel="noopener noreferrer">Repository</a>
      )}
      {links.video && (
        <a href={links.video} target="_blank" rel="noopener noreferrer">Video</a>
      )}
    </p>
  )}
</article>

<style>
  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .card.featured {
    border-color: var(--accent);
  }

  .card h3 {
    margin: 0.25rem 0 0.5rem;
  }

  .tagline {
    margin: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
  }

  .badge {
    display: inline-block;
    color: var(--secondary);
    background: var(--secondary-soft);
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
    margin: 0;
  }

  .featured-tag {
    display: inline-block;
    color: var(--accent-strong);
    background: var(--accent-soft);
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
    margin: 0;
  }

  .prose :global(h4) {
    font-size: 1rem;
    margin: 1.25rem 0 0.5rem;
  }

  .prose :global(h5) {
    font-size: 0.95rem;
    margin: 1rem 0 0.4rem;
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .tech li {
    background: var(--surface-tint);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.2rem 0.65rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin: 1.25rem 0 0;
  }
</style>
