---
import type { CollectionEntry } from 'astro:content';
import FeaturedCard from './FeaturedCard.astro';

interface Props {
  technical?: CollectionEntry<'projects'>;
  professional?: CollectionEntry<'projects'>;
}

const { technical, professional } = Astro.props;
---
<section id="highlighted" aria-label="Highlighted projects">
  <h2 class="sr-only">Highlighted projects</h2>
  <div class="band">
    {technical && (
      <div class="slot">
        <p class="role-label">The deep build</p>
        <FeaturedCard project={technical} />
      </div>
    )}
    {professional && (
      <div class="slot">
        <p class="role-label">From my day job</p>
        <FeaturedCard project={professional} />
      </div>
    )}
  </div>
</section>

<style>
  .band {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    align-items: stretch;
  }

  .slot {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .slot :global(.featured-card) {
    flex: 1;
  }

  .role-label {
    margin: 0 0 0.6rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }

  @media (max-width: 960px) {
    .band {
      grid-template-columns: 1fr;
    }
  }
</style>
