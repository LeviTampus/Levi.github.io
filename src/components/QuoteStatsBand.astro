---
import { skillIcons } from '../data/skillIcons';

const stats = [
  { value: '11+', label: 'years in professional support', svg: skillIcons.Headset, tone: 'accent' },
  { value: '4', label: 'years in integration support', svg: skillIcons.Integrations, tone: 'plain' },
];
---
<section id="stats" aria-label="By the numbers">
  <ul class="band">
    <li class="quote">
      <span class="quote-mark" aria-hidden="true">“</span>
      <p class="quote-text">Still curious. Still learning. Always building.</p>
      <p class="attribution">— Levi</p>
    </li>
    {stats.map((s) => (
      <li class={`stat ${s.tone}`}>
        <span class="stat-icon" aria-hidden="true" set:html={s.svg} />
        <span class="value">{s.value}</span>
        <span class="label">{s.label}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .band {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .quote {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.6rem;
    min-height: 8.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .quote-mark {
    position: absolute;
    top: -0.6rem;
    left: 0.6rem;
    font-family: var(--font-display);
    font-size: 5rem;
    line-height: 1;
    color: var(--accent);
    opacity: 0.16;
  }

  .quote-text {
    position: relative;
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink);
  }

  .attribution {
    position: relative;
    margin: 0;
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: 1.45rem;
    line-height: 1;
    color: var(--accent-strong);
  }

  .stat {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.35rem;
    min-height: 8.5rem;
    padding: 1.25rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .stat.accent {
    background: var(--accent-deep);
    border-color: var(--accent-deep);
    color: var(--accent-ink);
  }

  .stat-icon {
    display: grid;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    margin-bottom: 0.15rem;
    color: var(--accent);
  }

  .stat.accent .stat-icon {
    color: var(--accent-ink);
  }

  .stat-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .value {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1;
  }

  .label {
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.25;
  }

  @media (max-width: 900px) {
    .band {
      grid-template-columns: 1fr 1fr;
    }

    .quote {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .band {
      grid-template-columns: 1fr;
    }
  }
</style>
