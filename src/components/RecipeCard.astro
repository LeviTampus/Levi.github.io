---
import type { CollectionEntry } from 'astro:content';
import ZoomableImage from './ZoomableImage.astro';

interface Props {
  recipe: CollectionEntry<'recipes'>;
}

const { recipe } = Astro.props;
const { title, workatoUrl, purpose, access, image, imageAlt, imageWidth, imageHeight } =
  recipe.data;
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
---
<article class="tcard">
  <span class="kind">Recipe</span>
  <h3>{title}</h3>
  {purpose && <p class="line">{purpose}</p>}
  {image && (
    <ZoomableImage
      src={`${base}/${image}`}
      alt={imageAlt ?? `${title} screenshot`}
      width={imageWidth}
      height={imageHeight}
      zoomId={`zoom-recipe-${recipe.slug}`}
    />
  )}
  <p class="links">
    <a href={workatoUrl} target="_blank" rel="noopener noreferrer">
      View in Workato{access === 'gated' ? ' (sign-in)' : ''}
    </a>
  </p>
</article>

<style>
  .tcard {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    padding: 1rem 1.05rem;
  }

  .kind {
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-strong);
    background: var(--accent-soft);
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
  }

  h3 {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.25;
  }

  .line {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .links {
    margin: 0.1rem 0 0;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .links a {
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
  }
</style>
