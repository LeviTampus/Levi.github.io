---
interface Props {
  company: string;
  title: string;
  dates: string;
  bullets: string[];
  variant?: 'current' | 'earlier';
}

const { company, title, dates, bullets, variant = 'current' } = Astro.props;
---
<article class={`role ${variant}`}>
  <header>
    {variant === 'current' ? (
      <p class="tag current-label">Current</p>
    ) : (
      <p class="tag earlier-label">Earlier experience</p>
    )}
    <h3>{title} — {company}</h3>
    <p class="tag dates">{dates}</p>
  </header>
  <ul>
    {bullets.map((b) => (
      <li>{b}</li>
    ))}
  </ul>
</article>

<style>
  .role {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius-s);
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.25rem;
  }

  .role h3 {
    margin: 0 0 0.25rem;
  }

  .current-label {
    display: inline-block;
    margin: 0 0 0.5rem;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    padding: 0.1rem 0.5rem;
  }

  .role.earlier {
    border-left-color: var(--border);
    background: var(--surface-tint);
    margin-bottom: 0;
  }

  .role.earlier h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--muted);
  }

  .role.earlier ul {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .earlier-label {
    margin: 0 0 0.5rem;
    color: var(--muted);
  }

  .dates {
    margin: 0 0 0.75rem;
    color: var(--muted);
  }

  .role ul {
    margin: 0;
    padding-left: 1.25rem;
  }

  .role li + li {
    margin-top: 0.5rem;
  }
</style>
