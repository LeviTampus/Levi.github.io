---
import { site, navLinks } from '../data/site';
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const path = Astro.url.pathname;
const linkHref = (href: string) => `${base}${href}`;
const isCurrent = (href: string) =>
  href === '/' ? path === `${base}/` : path.startsWith(linkHref(href));
---
<nav aria-label="Primary">
  <a class="brand" href={`${base}/`}>{site.name}</a>
  <ul class="links">
    {navLinks.map((l) => (
      <li>
        <a
          href={linkHref(l.href)}
          aria-current={isCurrent(l.href) ? 'page' : undefined}
        >
          {l.label}
        </a>
      </li>
    ))}
  </ul>
  <a class="connect" href={`mailto:${site.email}`}>Let's connect</a>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 10;
    min-height: var(--nav-h);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 0.5rem 1.25rem;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .brand {
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 800;
    white-space: nowrap;
  }

  .links {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 0 0 0 auto;
    padding: 0;
    overflow-x: auto;
    min-width: 0;
    scrollbar-width: none;
  }

  .links::-webkit-scrollbar {
    display: none;
  }

  .links a {
    color: var(--muted);
    text-decoration: none;
    font-weight: 600;
    padding: 0.25rem 0;
    white-space: nowrap;
  }

  .links a[aria-current="page"],
  .links a:hover {
    color: var(--accent-strong);
  }

  .connect {
    background: var(--accent-deep);
    color: var(--accent-ink);
    font-weight: 700;
    text-decoration: none;
    border-radius: 999px;
    padding: 0.5rem 1.15rem;
    white-space: nowrap;
  }

  .connect:hover {
    background: var(--accent-strong);
  }

  @media (max-width: 760px) {
    .links {
      order: 3;
      flex-basis: 100%;
      padding-bottom: 0.15rem;
    }
    .connect {
      margin-left: auto;
    }
  }
</style>
