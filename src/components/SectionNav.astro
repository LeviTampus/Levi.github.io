---
import { site, navLinks } from '../data/site';
---
<nav aria-label="Sections">
  <a class="brand" href="#top">{site.name}</a>
  <ul class="links">
    {navLinks.map((l) => (
      <li><a href={l.href}>{l.label}</a></li>
    ))}
  </ul>
  <a class="connect" href="#contact">Let's connect →</a>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 10;
    min-height: var(--nav-h);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 0.5rem 1.25rem;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .brand {
    color: var(--ink);
    text-decoration: none;
    font-weight: 800;
    white-space: nowrap;
  }

  .links {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.25rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .links::-webkit-scrollbar {
    display: none;
  }

  .links a {
    color: var(--muted);
    text-decoration: none;
    font-weight: 600;
    padding: 0.25rem 0;
    white-space: nowrap;
  }

  .links a:hover {
    color: var(--accent-strong);
  }

  .connect {
    margin-left: auto;
    background: var(--accent-strong);
    color: var(--accent-ink);
    font-weight: 700;
    text-decoration: none;
    border-radius: var(--radius);
    padding: 0.4rem 0.9rem;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .links {
      order: 3;
      flex-basis: 100%;
      padding-bottom: 0.15rem;
    }
  }
</style>
