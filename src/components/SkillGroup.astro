---
interface Props {
  title: string;
  items: string[];
}

const { title, items } = Astro.props;
---
<div class="skill-group">
  <h3>{title}</h3>
  <ul>
    {items.map((i) => (
      <li class="tag">{i}</li>
    ))}
  </ul>
</div>

<style>
  .skill-group h3 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }

  .skill-group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
  }

  .skill-group li {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 0.25rem 0.6rem;
  }
</style>
