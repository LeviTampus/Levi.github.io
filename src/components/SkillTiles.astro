---
import { skillGroups } from '../data/skills';
---
<ul class="tiles">
  {skillGroups.map((group) => (
    <li class="tile">
      <span class="icon" aria-hidden="true">{group.icon}</span>
      <h3>{group.title}</h3>
      <p>{group.blurb}</p>
    </li>
  ))}
</ul>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: 0.85rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tile {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.1rem;
  }

  .icon {
    font-size: 1.4rem;
    line-height: 1;
    display: block;
    margin-bottom: 0.5rem;
  }

  .tile h3 {
    margin: 0 0 0.2rem;
    font-size: 1rem;
  }

  .tile p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--muted);
  }
</style>
