---
import { skillGroups } from '../data/skills';
---
<ul class="tiles">
  {skillGroups.map((group) => (
    <li class="tile">
      <span class="icon" aria-hidden="true" set:html={group.svg} />
      <h3>{group.title}</h3>
    </li>
  ))}
</ul>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    gap: 1px;
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 0;
    aspect-ratio: 1 / 1;
    padding: 0.5rem 0.3rem;
    text-align: center;
    background: var(--surface);
    transition: background-color 140ms ease;
  }

  .tile:hover {
    background: var(--accent-soft);
  }

  .icon {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    color: var(--ink);
  }

  .tile:hover .icon {
    color: var(--accent-strong);
  }

  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .tile h3 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--ink);
    word-break: normal;
    overflow-wrap: normal;
  }

  @media (max-width: 1099px) {
    .tiles {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .icon {
      width: 1.5rem;
      height: 1.5rem;
    }

    .tile h3 {
      font-size: 0.72rem;
    }
  }
</style>
