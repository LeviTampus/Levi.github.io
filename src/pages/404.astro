---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
---

<Base
  title="Page not found — Levi Joan Tampus"
  description="This page does not exist. Return to the portfolio of Levi Joan Tampus."
>
  <section aria-label="Page not found">
    <h1>404 — Nothing here</h1>
    <p>The page you're looking for doesn't exist.</p>
    <p>
      <Button href={`${base}/`}>Back to the portfolio</Button>
    </p>
  </section>
</Base>

<style>
  section {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }
</style>
