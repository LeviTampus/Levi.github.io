---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found — Levi Joan Tampus"
  description="This page does not exist. Return to the portfolio of Levi Joan Tampus."
>
  <section aria-label="Page not found">
    <h1>404 — Nothing here</h1>
    <p>The page you're looking for doesn't exist.</p>
    <p>
      <a class="button" href={`${import.meta.env.BASE_URL}`}>Back to the portfolio</a>
    </p>
  </section>
</Base>

<style>
  section {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  .button {
    display: inline-block;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
    text-decoration: none;
    border-radius: var(--radius);
    padding: 0.6rem 1.25rem;
  }
</style>
