---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SkillTiles from '../components/SkillTiles.astro';
import HomeFeatured from '../components/HomeFeatured.astro';
import QuoteStatsBand from '../components/QuoteStatsBand.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';
import { getCollection } from 'astro:content';

const experience = (await getCollection('experience'))
  .filter((entry) => entry.data.tier === 'current')
  .sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = projects.find((p) => p.data.featured) ?? projects[0];

const title = 'Levi Joan Tampus — Product Support & Integrations';
const description =
  'Portfolio of Levi Joan Tampus: 11 years of professional support experience, 4 years in enterprise integration support, Workato, APIs, automation, and AI agent projects.';
---

<Base title={title} description={description}>
  <Hero />

  <section id="capabilities" aria-label="Technical capabilities">
    <h2>What I work with</h2>
    <p class="section-sub">
      From integrations and APIs to AI agents — the areas I work in day to day.
    </p>
    <SkillTiles />
  </section>

  {featured && <HomeFeatured project={featured} experience={experience} />}

  <QuoteStatsBand />

  <section id="contact" aria-label="Contact">
    <h2>Let's work together</h2>
    <p class="section-sub">
      Have a project, integration challenge, or support role in mind? I'd love to hear about it.
    </p>
    <p class="contact-actions">
      <Button href={`mailto:${site.email}`}>Email me</Button>
      <Button href={site.linkedin} variant="secondary" external>LinkedIn</Button>
    </p>
  </section>
</Base>

<style>
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin: 0;
  }
</style>
