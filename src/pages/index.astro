---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Role from '../components/Role.astro';
import SkillTiles from '../components/SkillTiles.astro';
import ProjectCard from '../components/ProjectCard.astro';
import RecipeRow from '../components/RecipeRow.astro';
import CertTile from '../components/CertTile.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';
import { getCollection } from 'astro:content';

const experience = (await getCollection('experience')).sort(
  (a, b) => a.data.order - b.data.order,
);
const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const recipes = (await getCollection('recipes')).sort(
  (a, b) => a.data.order - b.data.order,
);
const archiveItems = (await getCollection('archive')).sort(
  (a, b) => a.data.order - b.data.order,
);
const certs = await getCollection('certs');
const recognition = (await getCollection('recognition')).filter(
  (item) => item.data.status === 'published',
);

const title = 'Levi Joan Tampus — Technical Support, Integrations & AI';
const description =
  'Portfolio of Levi Joan Tampus: 11 years in technical support, Workato integrations and APIs, workflow automation, production troubleshooting, and AI agent projects.';
---

<Base title={title} description={description}>
  <Hero />

  <section id="summary" aria-label="Professional summary">
    <h2>A quick intro</h2>
    <p>
      I've spent 11 years in customer and technical support. For the last four,
      at Workato, I've worked on enterprise integrations — building and
      troubleshooting connections between business systems, working with APIs,
      and resolving data and integration issues in production.
    </p>
    <p>
      My favorite kind of work starts with "this should be working, but it
      isn't." I reproduce it, dig through logs and API behavior until I find the
      real cause, then fix it or hand Engineering an escalation they can act on
      immediately. Somewhere along the way I went from Level 1 to Level 2
      support — and started automating the repetitive parts with Slackbot and
      Workato Genie.
    </p>
    <p>
      These days I'm building on that foundation, expanding into software and AI
      application engineering and building practical systems around APIs,
      automation, and AI agents. This site is where I keep the things I've built
      and learned. <span class="handnote">Same curiosity, higher altitude ♡</span>
    </p>
  </section>

  <section id="skills" aria-label="Technical capabilities">
    <h2>What I work with</h2>
    <p class="section-sub">
      Capability areas built over 11 years of support and integrations — from
      connecting business systems to applying AI to real support problems.
    </p>
    <SkillTiles />
  </section>

  <section id="experience" aria-label="Professional experience">
    <h2>Where I've worked</h2>
    <p class="section-sub">Support → integrations → automation → AI. The short version of 11 years.</p>
    {experience.map((entry) => (
      <Role
        company={entry.data.company}
        title={entry.data.title}
        dates={entry.data.dates}
        bullets={entry.data.bullets}
        variant={entry.data.tier}
      />
    ))}
  </section>

  {recognition.length > 0 && (
    <section id="recognition" aria-label="Recognition">
      <h2>Kind words</h2>
      <p class="section-sub">Feedback and kudos collected along the way.</p>
      {recognition.map((item) => (
        <article class="archived">
          <h3>{item.data.title}</h3>
          <p>{item.data.context}</p>
        </article>
      ))}
    </section>
  )}

  <section id="projects" aria-label="Featured projects">
    <h2>Things I've built</h2>
    <p class="section-sub">Professional and personal work — labeled honestly. The featured one is the deepest case study.</p>
    {projects.map(async (p) => {
      const { Content } = await p.render();
      return (
        <ProjectCard project={p}>
          <Content />
        </ProjectCard>
      );
    })}
  </section>

  <section id="recipes" aria-label="Workato recipes and workflow examples">
    <h2>Workato recipes</h2>
    <p class="section-sub">A couple of integration and workflow builds. They live in Workato, so you'll need a sign-in to look inside.</p>
    {recipes.map((r) => (
      <RecipeRow recipe={r} />
    ))}
  </section>

  <section id="archive" aria-label="Earlier and archived work">
    <h2>From the archives</h2>
    <p class="section-sub">Older work that shows where I started — kept for context, not the main act.</p>
    {archiveItems.map(async (item) => {
      const { Content } = await item.render();
      return (
        <article class="archived">
          <p class="tag muted">Archived · {item.data.period}</p>
          <h3>{item.data.title}</h3>
          <p>{item.data.context}</p>
          <Content />
          {item.data.links.playlist && (
            <p>
              <a href={item.data.links.playlist} target="_blank" rel="noopener noreferrer">
                Watch the training playlist
              </a>
            </p>
          )}
        </article>
      );
    })}
  </section>

  <section id="certifications" aria-label="Certifications">
    <h2>Certifications</h2>
    <p class="section-sub">Coursework I'm happy to show — each tile links to its verification page.</p>
    <div class="cert-grid">
      {certs.map((c) => (
        <CertTile cert={c} />
      ))}
    </div>
  </section>

  <section id="contact" aria-label="Contact">
    <h2>Say hello</h2>
    <p class="section-sub">Something here catch your interest? My inbox is open.</p>
    <ul class="contact-links">
      <li><Button href={`mailto:${site.email}`}>{site.email}</Button></li>
      <li><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      <li><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
    </ul>
    <p class="tag">{site.location}</p>
  </section>

  <aside class="quote" aria-label="Personal motto">
    <p class="handnote big">Still curious. Still learning. Always building.</p>
    <p class="tag">— Levi</p>
  </aside>
</Base>

<style>
  .archived {
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
    color: var(--muted);
  }

  .archived h3 {
    color: var(--ink);
    margin: 0.25rem 0 0.5rem;
  }

  .archived .muted {
    color: var(--muted);
    margin: 0;
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1rem;
  }

  .contact-links {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .quote {
    margin-top: var(--gap-section);
    background: var(--accent-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem 2rem;
    text-align: center;
  }

  .handnote.big {
    font-size: 1.8rem;
    color: var(--ink);
  }

  .quote .tag {
    color: var(--muted);
    margin: 0.25rem 0 0;
  }
</style>
