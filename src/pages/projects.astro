---
import Base from '../layouts/Base.astro';
import ProjectHero from '../components/ProjectHero.astro';
import TrackLane from '../components/TrackLane.astro';
import TrackCard from '../components/TrackCard.astro';
import RecipeCard from '../components/RecipeCard.astro';
import Button from '../components/Button.astro';
import { getCollection } from 'astro:content';
import { tracks, type TrackId } from '../data/tracks';

const projects = await getCollection('projects');
const featured = projects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

const byTrack = (track: TrackId) =>
  projects
    .filter((p) => p.data.track === track)
    .sort((a, b) => a.data.order - b.data.order);

const recipes = (await getCollection('recipes')).sort(
  (a, b) => a.data.order - b.data.order,
);
const archiveItems = (await getCollection('archive')).sort(
  (a, b) => a.data.order - b.data.order,
);

const title = 'Projects — Levi Joan Tampus';
const description =
  'AI agents and automation from Levi Joan Tampus: built at work in Workato, shipped low-code in n8n, and coded from scratch in Python.';
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
---

<Base title={title} description={description}>
  <section id="projects" aria-label="Projects">
    <h1>Projects</h1>
    <p class="section-sub">
      Professional and personal work, labeled honestly. Here's how it fits together.
    </p>
    <ProjectHero projects={featured} />
  </section>

  <section id="all-projects" aria-label="AI development projects">
    <h2>AI development Projects</h2>
    <p class="lede">
      AI agents and automation: built at work in Workato, shipped low-code in n8n, and coded
      from scratch in Python.
    </p>
    <div class="lanes">
      {tracks.map((t) => (
        <TrackLane
          platform={t.platform}
          skill={t.skill}
          note={t.note}
          count={
            t.id === 'workato'
              ? byTrack('workato').length + recipes.length
              : byTrack(t.id).length
          }
        >
          {byTrack(t.id).map((p) => (
            <TrackCard project={p} />
          ))}
          {t.id === 'workato' && recipes.map((r) => <RecipeCard recipe={r} />)}
        </TrackLane>
      ))}
    </div>
  </section>

  <section id="archive" aria-label="Earlier and archived work">
    <h2>From the archives</h2>
    <p class="section-sub">
      Older work from where I started, kept for context.
    </p>
    {archiveItems.map(async (item) => {
      const { Content } = await item.render();
      return (
        <article class="archived">
          <p class="tag muted">Archived {item.data.period}</p>
          <h3>{item.data.title}</h3>
          <p>{item.data.context}</p>
          <Content />
          {item.data.links.playlist && (
            <p>
              <a href={item.data.links.playlist} target="_blank" rel="noopener noreferrer">
                Watch the training playlist
              </a>
            </p>
          )}
          {item.data.links.repo && (
            <p>
              <a href={item.data.links.repo} target="_blank" rel="noopener noreferrer">
                Repository
              </a>
            </p>
          )}
          {item.data.links.demo && (
            <p>
              <a href={item.data.links.demo} target="_blank" rel="noopener noreferrer">
                View the old build
              </a>
            </p>
          )}
        </article>
      );
    })}
  </section>

  <section id="contact" aria-label="Contact">
    <h2>Want to talk about a project?</h2>
    <p class="section-sub">
      I'm always open to discussing integrations, support work, or new opportunities.
    </p>
    <p class="contact-actions">
      <Button href="mailto:levijoantampus@gmail.com">Email me</Button>
      <Button href={`${base}/certificates`} variant="secondary">View certificates</Button>
    </p>
  </section>
</Base>

<style>
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
    margin: 0 0 0.5rem;
  }

  .lede {
    margin: 0 0 1.5rem;
    max-width: 46rem;
    color: var(--muted);
    font-size: 1.02rem;
  }

  .lanes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    align-items: start;
  }

  @media (max-width: 900px) {
    .lanes {
      grid-template-columns: 1fr;
    }
  }

  .archived {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1.25rem 1.5rem;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .archived h3 {
    color: var(--ink);
    margin: 0.25rem 0 0.5rem;
  }

  .archived .muted {
    color: var(--muted);
    margin: 0;
  }

  .archived p {
    margin: 0.5rem 0 0;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin: 0;
  }
</style>
