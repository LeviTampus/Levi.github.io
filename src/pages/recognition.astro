---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { recognitionImageMeta } from '../data/recognitionImages';

const items = (await getCollection('recognition')).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);
const featured = items.find((item) => item.data.featured);
const rest = items.filter((item) => item !== featured);
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');

const kindLabel: Record<string, string> = {
  award: 'Award',
  kudos: 'Kudos',
  feedback: 'Feedback',
};

const imageSrc = (file: string) => `${base}/recognition/${file}`;
const imageAlt = (item: CollectionEntry<'recognition'>, index: number) => {
  const suffix = item.data.assets.length > 1 ? ` (image ${index + 1})` : '';
  return `${item.data.title} — ${kindLabel[item.data.kind]}${suffix}`;
};
const zoomId = (item: CollectionEntry<'recognition'>, index: number) =>
  `zoom-${item.id}-${index}`;

const title = 'Recognition — Levi Joan Tampus';
const description =
  'Customer kudos, feedback, and teammate awards from Levi Joan Tampus — kept as they came in.';
---

<Base title={title} description={description}>
  <section id="recognition" aria-label="Recognition">
    <h1>Recognition</h1>
    <p class="section-sub">
      Praise from customers and teammates, kept as it came in — typos and all.
    </p>

    {featured && (
      <article class="featured">
        <div class="featured-gallery">
          {featured.data.assets.map((file, i) => (
            <figure>
              <a
                class="shot-link"
                href={`#${zoomId(featured, i)}`}
                aria-label={`Enlarge: ${imageAlt(featured, i)}`}
              >
                <img
                  src={imageSrc(file)}
                  alt={imageAlt(featured, i)}
                  width={recognitionImageMeta[file]?.width}
                  height={recognitionImageMeta[file]?.height}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  decoding="async"
                />
              </a>
            </figure>
          ))}
        </div>
        <div class="featured-copy">
          <p class="badges">
            <span class="tag badge">{kindLabel[featured.data.kind]}</span>
          </p>
          <h2>{featured.data.title}</h2>
          <p class="source">
            {featured.data.source}
            {featured.data.period && <> · <span class="period">{featured.data.period}</span></>}
          </p>
          <blockquote class="quote">“{featured.data.quote}”</blockquote>
        </div>
      </article>
    )}

    {rest.length > 0 && (
      <>
        <h2 class="grid-head">More praise</h2>
        <ul class="grid">
          {rest.map((item) => (
            <li class="card">
              {item.data.assets.map((file, i) => (
                <a
                  class="shot-link"
                  href={`#${zoomId(item, i)}`}
                  aria-label={`Enlarge: ${imageAlt(item, i)}`}
                >
                  <img
                    class="shot"
                    src={imageSrc(file)}
                    alt={imageAlt(item, i)}
                    width={recognitionImageMeta[file]?.width}
                    height={recognitionImageMeta[file]?.height}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              ))}
              <p class="badges">
                <span class="tag badge">{kindLabel[item.data.kind]}</span>
              </p>
              <h3>{item.data.title}</h3>
              <blockquote class="quote">“{item.data.quote}”</blockquote>
            </li>
          ))}
        </ul>
      </>
    )}

    <div class="zooms">
      {items.flatMap((item) =>
        item.data.assets.map((file, i) => (
          <a
            class="lightbox"
            id={zoomId(item, i)}
            href="#recognition"
            aria-label={`Close enlarged image of ${item.data.title}`}
          >
            <img
              src={imageSrc(file)}
              alt={imageAlt(item, i)}
              width={recognitionImageMeta[file]?.width}
              height={recognitionImageMeta[file]?.height}
              decoding="async"
            />
          </a>
        )),
      )}
    </div>
  </section>

  <section id="contact" aria-label="Contact">
    <h2>Want to work together?</h2>
    <p class="section-sub">
      I'm always happy to talk about support, integrations, or new opportunities.
    </p>
    <p class="contact-actions">
      <Button href="mailto:levijoantampus@gmail.com">Email me</Button>
      <Button href={`${base}/projects`} variant="secondary">View projects</Button>
    </p>
  </section>
</Base>

<style>
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
    margin: 0 0 0.5rem;
  }

  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    padding: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .featured-gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    align-items: start;
  }

  .featured-gallery figure {
    margin: 0;
  }

  .featured-gallery img,
  .card .shot {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    background: var(--surface-tint);
  }

  .featured-copy h2 {
    margin: 0.35rem 0 0.25rem;
    font-size: 1.5rem;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
  }

  .badge {
    display: inline-block;
    color: var(--accent-strong);
    background: var(--accent-soft);
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
  }

  .source {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-weight: 600;
  }

  .period {
    font-weight: 500;
  }

  .quote {
    margin: 0;
    padding: 0;
    border: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
  }

  .grid-head {
    margin: 0 0 1rem;
    font-size: 1.15rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    grid-auto-rows: 1fr;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    padding: 1.25rem;
  }

  /* Uniform image box keeps every card the same height without cropping: the
     full screenshot is shown inside a fixed square, letterboxed on the tint. */
  .card .shot {
    aspect-ratio: 1 / 1;
    object-fit: contain;
    margin-bottom: 0.25rem;
  }

  .card h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .shot-link {
    display: block;
    border-radius: var(--radius-s);
    cursor: zoom-in;
  }

  .zooms {
    display: contents;
  }

  /* CSS-only zoom: clicking a screenshot targets its full-size overlay. */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    place-items: center;
    padding: clamp(1rem, 4vw, 2.5rem);
    background: rgba(43, 39, 36, 0.85);
    text-decoration: none;
    cursor: zoom-out;
  }

  .lightbox:target {
    display: grid;
  }

  .lightbox img {
    max-width: min(94vw, 1200px);
    max-height: 90vh;
    width: auto;
    height: auto;
    border-radius: var(--radius-s);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .lightbox::after {
    content: 'Click anywhere to close';
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--accent-ink);
    font-size: 0.85rem;
    font-weight: 600;
    opacity: 0.85;
  }

  :global(html:has(.lightbox:target)) {
    overflow: hidden;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin: 0;
  }

  @media (max-width: 760px) {
    .featured {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .featured-gallery {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 460px) {
    .featured-gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
